<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.antfin.library.usercenter.dao.mapper.SysUserMapper">

    <select id="selectByUserId" resultType="com.antfin.library.usercenter.dao.entity.SysUserEntity">
        SELECT id, user_id, user_name, user_type, user_level, department, gmt_create, gmt_modified
        FROM sys_user
        WHERE user_id = #{userId}
    </select>

</mapper>
