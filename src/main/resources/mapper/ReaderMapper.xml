<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.library.reader.mapper.ReaderMapper">

    <resultMap id="readerMap" type="com.library.reader.entity.ReaderDO">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="readerNo" column="reader_no"/>
        <result property="phone" column="phone"/>
        <result property="name" column="name"/>
        <result property="deleted" column="is_deleted"/>
        <result property="gmtCreate" column="gmt_create"/>
        <result property="gmtModified" column="gmt_modified"/>
    </resultMap>

    <!-- 根据用户ID查询 -->
    <select id="selectByUserId" resultMap="readerMap">
        SELECT id, user_id, reader_no, phone, name, is_deleted, gmt_create, gmt_modified
        FROM reader
        WHERE user_id = #{userId}
    </select>

    <!-- 根据读者编号查询 -->
    <select id="selectByReaderNo" resultMap="readerMap">
        SELECT id, user_id, reader_no, phone, name, is_deleted, gmt_create, gmt_modified
        FROM reader
        WHERE reader_no = #{readerNo}
    </select>

</mapper>
